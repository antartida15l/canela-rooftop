# --- PostgreSQL ---
POSTGRES_USER=neurobridge
POSTGRES_PASSWORD=cambia_esto_por_algo_largo
POSTGRES_DB=neurobridge
POSTGRES_HOST_PORT=5433
# --- Backend ---
# Fuera de Docker se usa localhost y el puerto del host (5433)
DATABASE_URL=postgresql+psycopg://neurobridge:cambia_esto_por_algo_largo@localhost:5433/neurobridge
DATABASE_URL_TEST=postgresql+psycopg://neurobridge:TU_PASSWORD@localhost:5433/neurobridge_test
# Clave de pgcrypto para condicion_cifrada. NUNCA va en la base ni en logs.
CONDICION_KEY=genera_una_clave_de_32_bytes_o_mas
JWT_SECRET=genera_otro_secreto_distinto
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30
